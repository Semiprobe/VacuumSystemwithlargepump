{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for VacuumControl",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-set-theme",
    "core:window:allow-maximize",
    "core:window:allow-is-maximized",
    "dialog:default"
  ]
}
